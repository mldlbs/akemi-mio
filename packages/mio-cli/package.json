{
  "name": "mio-agent-runtime",
  "version": "0.13.2",
  "description": "Mio Agent Runtime installer and MCP intelligence layer",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "mio": "bin/mio.js"
  },
  "files": [
    "bin/",
    "server/",
    "adapters/",
    "observe/",
    "scripts/",
