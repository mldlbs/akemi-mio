    "@akemi-mio/evolution-learning": "^0.1.0",
    "@akemi-mio/evolution-strategy": "^0.1.0",
    "@akemi-mio/evolution-safety": "^0.1.0",
    "@akemi-mio/evolution-scheduler": "^0.1.0",
    "@akemi-mio/observer": "^0.1.2",
    "@akemi-mio/insight": "^0.1.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": ""
