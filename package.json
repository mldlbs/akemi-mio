{
  "name": "akemi-mio",
  "version": "1.0.0",
  "description": "秋山澪 AI Voice Assistant Wallpaper",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win portable",
    "build:win:installer": "npm run build && electron-builder --win nsis",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "download:model": "node scripts/download-model.cjs",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@kutalia/whisper-node-addon": "^1.1.0",
    "@playwright/mcp": "^0.0.76",
    "@xenova/transformers": "^2.17.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.0.2",
    "onnxruntime-node": "^1.26.0",
    "onnxruntime-web": "^1.26.0",
    "opencc-js": "^1.3.1",
    "sql.js": "^1.14.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  }
}
