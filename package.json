{
  "name": "akemi-mio",
  "version": "1.0.3",
  "description": "秋山澪 AI Voice Assistant Wallpaper",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win portable",
    "build:win:installer": "if exist out rmdir /s /q out & if exist dist-electron rmdir /s /q dist-electron & npm run build & electron-builder --win nsis",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "download:model": "node scripts/download-model.cjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:stress": "vitest run tests/main/**/__tests__/*.stress.test.ts tests/main/**/__tests__/*.benchmark.test.ts tests/main/**/__tests__/*endurance* tests/main/**/__tests__/*baseline*",
    "test:unit:fast": "vitest run --config vitest.config.unit-fast.ts",
    "typecheck:budget": "node scripts/typecheck-budget.mjs --budget 0",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "coverage": "vitest run --coverage",
    "test:renderer": "vitest run --config vitest.config.renderer.ts",
    "test:renderer:watch": "vitest --config vitest.config.renderer.ts",
    "coverage:renderer": "vitest run --config vitest.config.renderer.ts --coverage",
    "test:preload": "vitest run --config vitest.config.preload.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.199",
    "@browserbasehq/stagehand": "^3.7.1",
    "@kutalia/whisper-node-addon": "^1.1.0",
    "@playwright/mcp": "^0.0.76",
    "@types/better-sqlite3": "^7.6.13",
    "@xenova/transformers": "^2.17.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "koffi": "^3.0.2",
    "onnxruntime-node": "^1.26.0",
    "onnxruntime-web": "^1.26.0",
    "openai": "^6.49.0",
    "opencc-js": "^1.3.1",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "telegraf": "^4.16.3",
    "three": "^0.184.0",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-compact": "^9.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
