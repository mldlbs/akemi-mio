      "@akemi-mio/intelligence": ["./packages/intelligence/src"],
      "@akemi-mio/intelligence/*": ["./packages/intelligence/src/*"],
      "@akemi-mio/core": ["./packages/core/src"],
      "@akemi-mio/core/*": ["./packages/core/src/*"],
      "@akemi-mio/creativity": ["./packages/creativity/src"],
      "@akemi-mio/creativity/*": ["./packages/creativity/src/*"],
      "@akemi-mio/audio": ["./packages/audio/src"],
      "@akemi-mio/audio/*": ["./packages/audio/src/*"],
      "@akemi-mio/evolution": ["./packages/evolution/src"],
      "@akemi-mio/evolution/*": ["./packages/evolution/src/*"],
