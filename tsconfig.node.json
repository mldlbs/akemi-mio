{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "composite": true,
    "skipLibCheck": true,
    // 让 tsc 与 rollup 的口径对齐：rollup 按运行时值处理 import/export，
    // 而 tsc 默认会对「类型被当值使用/导出」静默擦除，导致"tsc 全绿但构建炸"。
    // 开启后必须对纯类型 import 写 `import type` 或内联 `type` 修饰符。
    "verbatimModuleSyntax": true,
    "outDir": "./out",
    "types": ["node"],
    "paths": {
      "@akemi-mio/audit": ["./packages/audit/src"],
      "@akemi-mio/audit/*": ["./packages/audit/src/*"],
      "@akemi-mio/blog": ["./packages/blog/src"],
      "@akemi-mio/blog/*": ["./packages/blog/src/*"],
      "@akemi-mio/blog-publish": ["./packages/blog-publish/src"],
      "@akemi-mio/blog-publish/*": ["./packages/blog-publish/src/*"],
      "@akemi-mio/capabilities": ["./packages/capabilities/src"],
