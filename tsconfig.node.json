      "@akemi-mio/evolution-workspace-cleanup": ["./packages/evolution-workspace-cleanup/src"],
      "@akemi-mio/evolution-workspace-cleanup/*": ["./packages/evolution-workspace-cleanup/src/*"],
      "@akemi-mio/evolution-core": ["./packages/evolution-core/src"],
      "@akemi-mio/evolution-tts-cleanup-dualmode": ["./packages/evolution-tts-cleanup-dualmode/src"],
      "@akemi-mio/evolution-behavior-prediction": ["./packages/evolution-behavior-prediction/src"],
